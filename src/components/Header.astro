---
import MovieSearchBar from "./MovieSearchBar.jsx";
import { Classic_malayalam_Movies } from "../data/movies";
import { Popular_Malayalam_movies } from "../data/movies";
// import { Top_Tamil_Movies } from "../data/movies";
// import { Top_Hindi_Movies } from "../data/movies";
import { New_Release_Malayalam_Movies } from "../data/movies";
import { Malayalam_Dubbed_Movies } from "../data/movies";
import { Malayalam_Comedy_Movies } from "../data/movies";
// import { Malayalam_Comedy_Movies2 } from "../data/movies";

import { Malayalam_Romantic_Movies } from "../data/movies";
import { New_movies } from "../data/movies";
import { New_movies2 } from "../data/movies";
import { Malayalam_Short_Movies } from "../data/movies";

import { Info } from "lucide-react";
const allMovies = [
  ...Classic_malayalam_Movies,
  ...Popular_Malayalam_movies,
  // ...Top_Tamil_Movies,
  // ...Top_Hindi_Movies,
  ...New_Release_Malayalam_Movies,
  ...Malayalam_Dubbed_Movies,
  ...Malayalam_Comedy_Movies,
  // ...Malayalam_Comedy_Movies2,
  ...Malayalam_Romantic_Movies,
  ...New_movies,
  ...New_movies2,
  ...Malayalam_Short_Movies,
];
---

<div
  class="sticky top-0 z-[1000] flex items-center justify-between gap-[18px] border-b border-white/10 bg-[rgba(5,5,7,0.78)] px-[clamp(16px,4vw,48px)] py-3.5 shadow-[0_10px_35px_rgba(0,0,0,0.35)] backdrop-blur-[18px] max-[900px]:flex-wrap max-[900px]:justify-center max-[600px]:items-stretch max-[600px]:p-3"
>
  <h2
    class="m-0 text-[clamp(28px,4vw,42px)] font-black tracking-[-1px] text-[#e50914] no-underline [text-shadow:0_0_24px_rgba(229,9,20,0.25)] max-[600px]:text-center"
  >
    MALLUFLIX
  </h2>

  <MovieSearchBar movies={allMovies} client:load />
  <nav
    class="flex flex-wrap items-center justify-end gap-2.5 max-[900px]:justify-center"
    aria-label="Main navigation"
  ></nav>
</div>
