---
import MovieSearchBar from "./MovieSearchBar.jsx";
import { Classic_malayalam_Movies } from "../data/movies";
import { Popular_Malayalam_movies } from "../data/movies";
import { Top_Tamil_Movies } from "../data/movies";
import { Top_Hindi_Movies } from "../data/movies";
import { New_Release_Malayalam_Movies } from "../data/movies";
import { Malayalam_Dubbed_Movies } from "../data/movies";
import { Malayalam_Comedy_Movies } from "../data/movies";
import { Malayalam_Romantic_Movies } from "../data/movies";
import { Info } from "lucide-react";
const allMovies = [
  ...Classic_malayalam_Movies,
  ...Popular_Malayalam_movies,
  ...Top_Tamil_Movies,
  ...Top_Hindi_Movies,
  ...New_Release_Malayalam_Movies,
  ...Malayalam_Dubbed_Movies,
  ...Malayalam_Comedy_Movies,
  ...Malayalam_Romantic_Movies,
];
---

<div class="navbar">
  <h2 class="footer-logo">MALLUFLIX</h2>

  <MovieSearchBar movies={allMovies} client:load />
  <div>
    <a href="/news" class="btn">Movie Updates</a>

    <a href="/trending" class="btn">Trending Movies</a>

    <a href="/about" class="btn">About</a>
  </div>
</div>
