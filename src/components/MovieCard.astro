---
const { image, title, year, link, channelName } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block h-full min-w-0 overflow-hidden rounded-xl border border-white/10 bg-[#121216] text-white no-underline shadow-[0_10px_28px_rgba(0,0,0,0.45)] transition duration-[280ms] after:pointer-events-none after:absolute after:inset-0 after:bg-[linear-gradient(180deg,transparent_35%,rgba(0,0,0,0.72)_100%)] after:opacity-0 after:transition-opacity after:duration-[280ms] focus-visible:border-[rgba(229,9,20,0.7)] focus-visible:outline-none focus-visible:after:opacity-100 sm:rounded-[18px] sm:shadow-[0_18px_45px_rgba(0,0,0,0.45)] [@media(hover:hover)]:hover:-translate-y-2 [@media(hover:hover)]:hover:scale-[1.02] [@media(hover:hover)]:hover:border-[rgba(229,9,20,0.45)] [@media(hover:hover)]:hover:shadow-[0_24px_60px_rgba(0,0,0,0.65),0_0_28px_rgba(229,9,20,0.25)] [@media(hover:hover)]:hover:after:opacity-100 active:scale-[0.98]"
>
  <img
    class="block aspect-[2/3] w-full bg-[#1a1a20] object-cover transition duration-300 [@media(hover:hover)]:group-hover:scale-105 [@media(hover:hover)]:group-hover:brightness-[0.78]"
    src={image}
    alt={title}
    width="400"
    height="600"
    loading="lazy"
    decoding="async"
  />

  <div class="relative z-[1] px-2.5 pb-3 pt-2.5 sm:px-[13px] sm:pb-3.5 sm:pt-3">
    <h3
      class="mb-1 mt-0 line-clamp-2 text-left text-[0.85rem] font-extrabold leading-tight text-white sm:mb-1.5 sm:text-[0.98rem]"
    >
      {title}
    </h3>
    {
      channelName && (
        <p class="m-0 truncate text-left text-xs font-semibold text-[#b8b8c2] sm:text-[0.86rem]">
          {channelName}
        </p>
      )
    }
    <p
      class="m-0 text-left text-xs font-semibold text-[#b8b8c2] sm:text-[0.86rem]"
    >
      {year}
    </p>
  </div>
</a>
