  <h1 id="top-movies" class="title">Top Malayalam Movies &#xBB;</h1>
  <div class="movie-card">
    {
      Top_Malayalam_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>

