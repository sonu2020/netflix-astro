          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>
  <h1 class={sectionTitleClass}>Malayalam Dubbed Movies &#xBB;</h1>
  <div class={movieGridClass}>
    {
      Malayalam_Dubbed_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>
  <h1 class={sectionTitleClass}>Classic Malayalam Movies &#xBB;</h1>
