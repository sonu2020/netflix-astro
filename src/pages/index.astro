---
import "../styles/global.css";

import Header from "../components/Header.astro";
import MovieCard from "../components/MovieCard.astro";
import Footer from "../components/Footer.astro";
import movies from "../data/movies.json";
// import wikiMovies from "../data/movies.json";
console.log(movies);

import {
  Top_Malayalam_Movies,
  Malayalam_Short_Movies,
  Trending_Movies,
  Classic_malayalam_Movies,
  Popular_Malayalam_movies,
  // Top_Tamil_Movies,
  // Top_Hindi_Movies,
  New_Release_Malayalam_Movies,
  Malayalam_Dubbed_Movies,
  Malayalam_Comedy_Movies,
  Malayalam_Romantic_Movies,
  New_movies,
  New_movies2,
  // Malayalam_Comedy_Movies2,
} from "../data/movies";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>MalluFlix</title>
  </head>
  <Header />

  <section class="hero-section">
    <div class="hero-content">
      <p class="eyebrow">Free Premium Malayalam Streaming Picks</p>
      <h1>Discover movies worth watching tonight.</h1>
      <p>
        Explore hand-picked Malayalam movies, comedy hits, romantic stories,
        classics, short films, and trending favourites in one cinematic space.
      </p>
      <div class="hero-actions">
        <a href="#top-movies" class="btn btn-primary">Start Watching</a>
        <a href="/about" class="btn btn-ghost">About MalluFlix</a>
      </div>
    </div>
  </section>

  <!-- <div class="movies">
    {
