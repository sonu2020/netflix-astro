  <h1 class={sectionTitleClass}>Evergreen Hit movies &#xBB;</h1>

  <div class={movieGridClass}>
    {
      Popular_Malayalam_movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>

  <h1 class={sectionTitleClass}>Popular Hit Movies &#xBB;</h1>
  <div class={movieGridClass}>
    {
      New_movies2.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>
  <h1 class={sectionTitleClass}>Malayalam Movies &#xBB;</h1>
  <div class={movieGridClass}>
    {
      New_movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>

  <h1 class={sectionTitleClass}>Malayalam Short Filims &#xBB;</h1>
  <div class={movieGridClass}>
    {
      Malayalam_Short_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>
  <Footer />

  <!-- <h1 class={sectionTitleClass}>Top Tamil Movies &#xBB;</h1> -->
  <!-- 
  <div class={movieGridClass}>
    {
      Top_Tamil_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
          channelName={movie.channelName}
        />
      ))
    }
  </div>
  <h1 class={sectionTitleClass}>Top Hindi Movies &#xBB;</h1> -->

  <!-- <div class={movieGridClass}>
    {
      Top_Hindi_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
