---
import "../styles/global.css";

import Header from "../components/Header.astro";
import MovieCard from "../components/MovieCard.astro";
import Footer from "../components/Footer.astro";
import movies from "../data/movies.json";
// import wikiMovies from "../data/movies.json";
console.log(movies);

import {
  Top_Malayalam_Movies,
  Malayalam_Short_Movies,
  Trending_Movies,
  Classic_malayalam_Movies,
  Popular_Malayalam_movies,
  // Top_Tamil_Movies,
  // Top_Hindi_Movies,
  New_Release_Malayalam_Movies,
  Malayalam_Dubbed_Movies,
  Malayalam_Comedy_Movies,
  Malayalam_Romantic_Movies,
  New_movies,
  New_movies2,
  // Malayalam_Comedy_Movies2,
} from "../data/movies";

const sectionTitleClass =
  "mx-auto mb-4 mt-[34px] max-w-[1440px] px-[clamp(16px,4vw,42px)] text-[clamp(1.35rem,3vw,2rem)] font-black tracking-[-0.03em] text-white";

const movieGridClass =
  "mx-auto grid h-auto max-w-[1440px] grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-[clamp(14px,2vw,24px)] overflow-visible bg-transparent px-[clamp(16px,4vw,42px)] pb-[22px] whitespace-normal max-[600px]:grid-cols-2";

const heroButtonClass =
  "inline-flex min-h-[42px] items-center justify-center rounded-full border border-transparent px-5 py-[11px] text-center font-extrabold tracking-[0.01em] text-white no-underline shadow-[0_10px_24px_rgba(229,9,20,0.22)] transition duration-250 hover:-translate-y-0.5 hover:shadow-[0_0_28px_rgba(229,9,20,0.25)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[rgba(229,9,20,0.35)] max-[600px]:w-full";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>MalluFlix</title>
  </head>
  <Header />

  <section
    class="mb-3 flex min-h-[clamp(420px,58vw,680px)] items-end bg-[linear-gradient(90deg,rgba(0,0,0,0.92)_0%,rgba(0,0,0,0.58)_46%,rgba(0,0,0,0.18)_100%),linear-gradient(0deg,#050505_0%,rgba(5,5,5,0.15)_40%),url('/thumbnails/home.jpg')] bg-cover bg-center bg-no-repeat px-[clamp(16px,5vw,72px)] py-[clamp(28px,6vw,76px)] max-[600px]:min-h-[520px] max-[600px]:items-end max-[600px]:bg-center max-[600px]:pt-[90px]"
  >
    <div class="max-w-[760px]">
      <p
        class="mb-3 mt-0 text-[0.82rem] font-black uppercase tracking-[0.16em] text-[#ff3b45]"
      >
        Free Premium Malayalam Streaming Picks
      </p>
      <h1
        class="mb-[18px] mt-0 text-[clamp(2.4rem,7vw,5.8rem)] leading-[0.95] tracking-[-0.06em]"
      >
        Discover movies worth watching tonight.
      </h1>
      <p
        class="mb-[26px] mt-0 max-w-[650px] text-[clamp(1rem,2vw,1.2rem)] leading-[1.7] text-[#e1e1e8]"
      >
        Explore hand-picked Malayalam movies, comedy hits, romantic stories,
        classics, short films, and trending favourites in one cinematic space.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="#top-movies"
          class={`${heroButtonClass} bg-[linear-gradient(135deg,#e50914,#9f0710)] hover:bg-[linear-gradient(135deg,#ff3b45,#e50914)]`}
        >
          Start Watching
        </a>
        <a
          href="/about"
          class={`${heroButtonClass} border-white/10 bg-white/[0.08] shadow-none hover:border-white/[0.22] hover:bg-white/[0.14]`}
        >
          About MalluFlix
        </a>
      </div>
    </div>
  </section>

  <!-- <div class="movies">
    {
      movies.map((movie) => (
        <div class="card">
          <h2>{movie.itemLabel}</h2>
          <p>{movie.pubdate}</p>
        </div>
      ))
    }
  </div> -->

  <h1 id="top-movies" class={sectionTitleClass}>Top Malayalam Movies &#xBB;</h1>
  <div class={movieGridClass}>
    {
      Top_Malayalam_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>

  <h1 class={sectionTitleClass}>Malayalam Romantic Movies &#xBB;</h1>
  <div class={movieGridClass}>
    {
      Malayalam_Romantic_Movies.map((movie) => (
        <MovieCard
          image={movie.image}
          title={movie.title}
          year={movie.year}
          link={movie.link}
        />
      ))
    }
  </div>
