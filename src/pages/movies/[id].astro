---
export const prerender = true;

import "../../styles/details.css";

import {
  Top_Malayalam_Movies,
  Trending_Movies,
  Classic_malayalam_Movies,
  Popular_Malayalam_movies,
  New_Release_Malayalam_Movies,
  Malayalam_Dubbed_Movies,
  Malayalam_Comedy_Movies,
  Malayalam_Romantic_Movies,
  Malayalam_Short_Movies,
  New_movies,
  New_movies2,
} from "../../data/movies";

export async function getStaticPaths() {
  const allMovies = [
    ...Top_Malayalam_Movies,
    ...Trending_Movies,
    ...Classic_malayalam_Movies,
    ...Popular_Malayalam_movies,
    ...New_Release_Malayalam_Movies,
    ...Malayalam_Dubbed_Movies,
    ...Malayalam_Comedy_Movies,
    ...Malayalam_Romantic_Movies,
    ...Malayalam_Short_Movies,
    ...New_movies,
    ...New_movies2,
  ];

  return allMovies.map((movie) => ({
    params: {
      id: movie.id.toString(),
    },
    props: {
      movie: movie,
    },
  }));
}

/* THIS MUST BE HERE */
const { movie } = Astro.props;
---
<div class="movie-page">

 

  <!-- Trailer -->
  <section class="trailer-section">
    <div class="trailer-container">
      <iframe
        src={`${movie.trailer.replace("watch?v=", "embed/")}?rel=0`}
        title={movie.title}
        allow="autoplay; encrypted-media; fullscreen"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <!-- Movie details -->
  <section class="movie-details">

    <h1>{movie.title}</h1>

    <div class="movie-meta">
      <span>{movie.year}</span>
      <span>{movie.genre}</span>
      <span>{movie.language}</span>
      <span>{movie.duration}</span>
      <span>{movie.rating}/10</span>
    </div>

    <p class="description">
      <strong>Description :</strong>
      {movie.description}
    </p>

    <p>
      <strong>Actors :</strong>
      {movie.mainActors}
    </p>

    <p>
      <strong>Channel Name :</strong>
      {movie.channelName}
    </p>
<div class="button-group">
  <a
    href={movie.youtube}
    target="_blank"
    rel="noopener noreferrer"
    class="watch-button"
  >
    Watch Full Movie
  </a>

  <a href="/" class="home-button">
    Home
  </a>
</div>

  </section>

</div>