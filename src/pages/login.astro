---
import "../styles/global.css";
---

<title>Sign in Page</title>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
<link rel="stylesheet" href="styles/indexstyle.css" />

<style>
  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 24px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.55)),
      url(thumbnails/the_netflix_login_background__canada__2024___by_logofeveryt_dh0w8qv-pre.jpg) center / cover no-repeat;
    color: white;
    font-family: Inter, "Segoe UI", system-ui, sans-serif;
  }

  .login-box {
    width: min(100%, 390px);
    text-align: center;
    padding: 28px;
    border-radius: 26px;
    background: rgba(8, 8, 11, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.68);
    backdrop-filter: blur(16px);
  }

  input {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    padding: 13px 16px;
    border-radius: 999px;
    margin: 8px 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    outline: none;
    transition: 0.25s ease;
  }

  input:focus {
    border-color: rgba(229, 9, 20, 0.75);
    box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.16);
  }

  input::placeholder {
    color: #9b9ba5;
  }

  button {
    flex: 1;
    min-height: 44px;
    padding: 10px 18px;
    margin-top: 10px;
    background: linear-gradient(135deg, #e50914, #9f0710);
    color: white;
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    font-weight: 900;
    transition: 0.25s ease;
  }

  button:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 28px rgba(229, 9, 20, 0.28);
  }

  .buttons {
    display: flex;
    gap: 12px;
    justify-content: space-between;
  }

  .title {
    font-size: 1.35rem;
    color: #ff3b45;
    margin: 8px 0 14px;
  }

  .text {
    font-size: 0.9rem;
    color: #b8b8c2;
    margin-top: 20px;
  }

  .text a {
    color: #ff3b45;
  }

  .button:active,
  button:active {
    transform: scale(0.98);
  }

  .logo {
    width: 100%;
    max-height: 100px;
    object-fit: contain;
  }

  @media (max-width: 460px) {
    .login-box {
      padding: 20px;
    }
  }
</style>

<div class="login-box">
  <img class="logo" src="thumbnails//malluflixlog.png" />
  <h2 class="title">Log In</h2>
  <input type="text" id="username" placeholder="Username" />
  <input type="password" id="password" placeholder="Password" />
  <!-- <div class="remember-forgot">
        <label><input type="checkbox" />Remember Me</label>
        <a href="#">Forgot password</a>
      </div> -->
  <div class="register-link">
    <h3 class="text">Don't have an account? <a href="#">Register</a></h3>
  </div>
  <div class="buttons">
    <button type="button" onclick="login()">Login</button>
    <button onclick="exitForm()">Exit</button>
  </div>
</div>
<script>
  // function login() {
  // //   let username = document.getElementById("username").value.trim();
  // //   let password = document.getElementById("password").value.trim();
  // //   if (username === "" || password === "") {
  // //     alert("Please enter Username and Password!");
  // //     return;
  // //   }
  // //   window.location.href = "home.html";
  // // }
  function exitForm() {
    let confirmExit = confirm("Are you sure you want to exit?");
    if (confirmExit) {
      window.close();
    }
  }
</script>
