---
import "../styles/global.css";
---

<title>Sign in Page</title>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />

<div
  class="flex min-h-screen items-center justify-center bg-[linear-gradient(90deg,rgba(0,0,0,0.92),rgba(0,0,0,0.55)),url('/thumbnails/the_netflix_login_background__canada__2024___by_logofeveryt_dh0w8qv-pre.jpg')] bg-cover bg-center bg-no-repeat p-6 text-white"
>
  <div
    class="w-[min(100%,390px)] rounded-[26px] border border-white/10 bg-[rgba(8,8,11,0.88)] p-7 text-center shadow-[0_28px_80px_rgba(0,0,0,0.68)] backdrop-blur-2xl max-[460px]:p-5"
  >
    <img
      class="h-auto max-h-[100px] w-full object-contain"
      src="/thumbnails/malluflixlog.png"
      alt="MalluFlix"
    />
    <h2 class="mb-3.5 mt-2 text-[1.35rem] font-bold text-[#ff3b45]">Log In</h2>
    <input
      class="my-2 w-full rounded-full border border-white/[0.12] bg-white/[0.08] px-4 py-[13px] text-white outline-none transition duration-250 placeholder:text-[#9b9ba5] focus:border-[rgba(229,9,20,0.75)] focus:shadow-[0_0_0_4px_rgba(229,9,20,0.16)]"
      type="text"
      id="username"
      placeholder="Username"
    />
    <input
      class="my-2 w-full rounded-full border border-white/[0.12] bg-white/[0.08] px-4 py-[13px] text-white outline-none transition duration-250 placeholder:text-[#9b9ba5] focus:border-[rgba(229,9,20,0.75)] focus:shadow-[0_0_0_4px_rgba(229,9,20,0.16)]"
      type="password"
      id="password"
      placeholder="Password"
    />
    <!-- <div class="remember-forgot">
        <label><input type="checkbox" />Remember Me</label>
        <a href="#">Forgot password</a>
      </div> -->
    <div class="register-link">
      <h3 class="mt-5 text-[0.9rem] font-bold text-[#b8b8c2]">
        Don't have an account? <a class="text-[#ff3b45]" href="#">Register</a>
      </h3>
    </div>
    <div class="flex justify-between gap-3">
      <button
        class="mt-2.5 min-h-11 flex-1 cursor-pointer rounded-full border-0 bg-[linear-gradient(135deg,#e50914,#9f0710)] px-[18px] py-2.5 font-black text-white transition duration-250 hover:-translate-y-0.5 hover:shadow-[0_0_28px_rgba(229,9,20,0.28)] active:scale-98"
        type="button"
        onclick="login()"
      >
        Login
      </button>
      <button
        class="mt-2.5 min-h-11 flex-1 cursor-pointer rounded-full border-0 bg-[linear-gradient(135deg,#e50914,#9f0710)] px-[18px] py-2.5 font-black text-white transition duration-250 hover:-translate-y-0.5 hover:shadow-[0_0_28px_rgba(229,9,20,0.28)] active:scale-98"
        onclick="exitForm()"
      >
        Exit
      </button>
    </div>
  </div>
</div>

<script>
  // function login() {
  // //   let username = document.getElementById("username").value.trim();
  // //   let password = document.getElementById("password").value.trim();
  // //   if (username === "" || password === "") {
  // //     alert("Please enter Username and Password!");
  // //     return;
  // //   }
  // //   window.location.href = "home.html";
  // // }
  function exitForm() {
    let confirmExit = confirm("Are you sure you want to exit?");
    if (confirmExit) {
      window.close();
    }
  }
</script>
