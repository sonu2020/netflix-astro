---
import { getTrendingMovies } from "../scripts/tmdb";
import "../styles/global.css";

interface Movie {
  id: number;
  title: string;
  poster_path: string;
  vote_average: number;
  release_date: string;
  overview: string;
}

const movies: Movie[] = await getTrendingMovies();
---

<h1
  class="mx-3 mb-[clamp(28px,5vw,52px)] mt-[clamp(28px,5vw,58px)] text-center text-[clamp(2.2rem,6vw,4.5rem)] leading-[0.98] tracking-[-0.055em] text-white after:mx-auto after:mt-5 after:block after:h-1 after:w-[92px] after:rounded-full after:bg-[linear-gradient(90deg,#e50914,#ff3b45)] after:content-['']"
>
  Trending Movies
</h1>

<div
  class="mx-auto grid max-w-[1400px] grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-[clamp(16px,2vw,26px)] px-[clamp(14px,4vw,42px)] pb-12"
>
  {
    movies.map((movie) => (
      <div class="overflow-hidden rounded-[22px] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.07),rgba(255,255,255,0.035))] shadow-[0_18px_45px_rgba(0,0,0,0.45)] transition duration-[280ms] hover:-translate-y-2 hover:border-[rgba(229,9,20,0.42)] hover:shadow-[0_26px_70px_rgba(0,0,0,0.58),0_0_24px_rgba(229,9,20,0.16)]">
        <img
          src={`https://image.tmdb.org/t/p/w500${movie.poster_path}`}
          alt={movie.title}
          class="block aspect-[2/3] h-auto w-full object-cover"
        />

        <div class="p-4">
          <h2 class="mb-2.5 mt-0 text-[1.16rem] leading-[1.3] text-white">
            {movie.title}
          </h2>

          <p class="my-1.5 text-[0.95rem] font-extrabold text-[#ffd166]">
            Rating: {movie.vote_average}
          </p>

          <p class="my-1.5 text-[0.95rem] text-[#9ab7ff]">
            Release Date: {movie.release_date}
          </p>

          <p class="mt-3 line-clamp-3 overflow-hidden text-[0.95rem] leading-[1.55] text-[#b8b8c2]">
            {movie.overview}
          </p>

          <a
            class="mt-[15px] inline-flex items-center justify-center rounded-full bg-[linear-gradient(135deg,#e50914,#9f0710)] px-[18px] py-[11px] font-extrabold text-white no-underline transition duration-250 hover:-translate-y-0.5 hover:bg-[linear-gradient(135deg,#ff3b45,#e50914)]"
            href={`/tmdb/${movie.id}`}
          >
            View More Details
          </a>
        </div>
      </div>
    ))
  }
</div>
